        {
          "id": "8764d78c-aa0f-45a9-a0b0-88a98c2e6236",
          "name": "Get StoreKit Subscription Status",
          "request": {
            "name": "Get StoreKit Subscription Status",
            "description": {
              "content": "Returns the current status of a StoreKit subscription by its original transaction ID. Useful for checking renewal state and expiry. The response includes normalized `is_active` and `auto_renew_enabled` booleans (SDK 1.2+); prefer these over the raw `status`/`auto_renew_status` fields for canonical access decisions.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "iap",
                "storekit-subscription-status"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "original_transaction_id",
                  "value": "<string>",
                  "description": "(Required) The StoreKit original transaction ID for the subscription."
                }
              ],
              "variable": []
            },
