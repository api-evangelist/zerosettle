                "iap",
                "entitlements"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "user_id",
                  "value": "<string>",
                  "description": "The user's external ID. Required unless `email` is provided."
                },
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<string>",
                  "description": "The user's email address. Deprecated -- use `user_id` instead."
                }
              ],
              "variable": []
